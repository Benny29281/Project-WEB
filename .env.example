# Template only: copy to .env and set your own values. Never commit real secrets.
# Leave blank to persist an automatically generated key in instance/.session_secret,
# or set one strong value and keep it unchanged between restarts.
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
SCRAPE_ALLOWED_HOSTS=instaxshop.co.id,www.instaxshop.co.id,jpckemang.com,www.jpckemang.com,fujishop.id,www.fujishop.id,galaxy.co.id,www.galaxy.co.id,doss.co.id,www.doss.co.id,focusnusantara.com,www.focusnusantara.com,blibli.com,www.blibli.com,plazakamera.com,www.plazakamera.com,tokopedia.com,www.tokopedia.com,taskamera.id,www.taskamera.id,shop.anekafoto.com,camera.co.id,www.camera.co.id,hopmarket.id,www.hopmarket.id,winstore.co.id,www.winstore.co.id,sinarphoto.com,www.sinarphoto.com,borneodigital.co.id,www.borneodigital.co.id,sentradigital.com,www.sentradigital.com,enterkomputer.com,www.enterkomputer.com
DATABASE_URL=sqlite:///project_web.db
COOKIE_SECURE=0
# Optional: identify the scraper and provide a contact address.
SCRAPER_USER_AGENT=ProjectWebScraping/1.0 (stock-monitor; contact: admin@example.com)
# Email stock-ready notifications. For Gmail, use an App Password, not your login password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# One or more notification recipients, separated by commas (or semicolons).
STOCK_ALERT_EMAILS=alamat1@example.com,alamat2@example.com,alamat3@example.com,alamat4@example.com,alamat5@example.com
# Legacy single-recipient setting; used only when STOCK_ALERT_EMAILS is blank.
STOCK_ALERT_EMAIL=
